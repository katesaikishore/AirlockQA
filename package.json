{
  "name": "qafind",
  "version": "2.3.0",
  "description": "TypeScript browser testing tools with configurable request policies and signed run evidence",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "qafind": "bin/qafind.js"
  },
  "files": [
    "bin/qafind.js",
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && vite build --config console/vite.config.ts",
    "console:build": "vite build --config console/vite.config.ts",
    "prepublishOnly": "npm run build",
    "test": "bun test",
    "qa:gui": "bun scripts/gui-smoke.ts",
    "qa": "bun run build && bun test && bun run qa:gui",
    "cli": "bun ./bin/qafind.ts",
    "demo:server": "bun ./examples/demo-store/server.ts",
    "test:isolated": "bash scripts/test-isolated.sh",
    "console:dev": "vite --config console/vite.config.ts",
    "console:typecheck": "tsc -p console/tsconfig.json",
    "qa:report": "bun ./bin/qafind.ts qa report",
    "qa:hunt": "bun ./scripts/qa-hunt.ts"
  },
  "keywords": [
    "playwright",
    "browser-testing",
    "e2e-testing",
    "request-policy",
    "test-evidence",
    "merkle-tree",
    "typescript"
  ],
  "author": "QAFind Core Team",
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "js-yaml": "^5.5.0",
    "picocolors": "^1.1.1",
    "playwright-core": "^1.65.0",
    "zod": "^4.6.7",
    "@babel/parser": "^8.1.0"
  },
  "peerDependencies": {
    "@playwright/test": "^1.65.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "5",
    "axe-core": "4.10.2",
    "express": "^5.3.0",
    "react": "19",
    "react-dom": "19",
    "typescript": "^7.0.2",
    "vite": "7"
  }
}
